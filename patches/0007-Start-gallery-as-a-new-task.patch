From 6813000d83a97c352931e31dfca8ab2d357b4a36 Mon Sep 17 00:00:00 2001
From: Arian <arian.kulmer@web.de>
Date: Sun, 31 May 2026 17:40:07 +0530
Subject: [PATCH 7/7] Start gallery as a new task

When launched from lockscreen user will have to unlock for the gallery to be opened, then the gallery is living in the camera process which is wrong.
Let it create a new task for it.
---
 smali/com/android/camera/module/j.smali | 4 ++++
 1 file changed, 4 insertions(+)

diff --git a/smali/com/android/camera/module/j.smali b/smali/com/android/camera/module/j.smali
index b081db69c..9a5bb1fc8 100644
--- a/smali/com/android/camera/module/j.smali
+++ b/smali/com/android/camera/module/j.smali
@@ -4207,6 +4207,10 @@
 
     invoke-virtual {p0, p1}, Landroid/content/Intent;->addCategory(Ljava/lang/String;)Landroid/content/Intent;
 
+    # FLAG_ACTIVITY_NEW_TASK
+    const p1, 0x10000000
+    invoke-virtual {p0, p1}, Landroid/content/Intent;->addFlags(I)Landroid/content/Intent;
+
     invoke-virtual {v1, p0}, Landroid/app/Activity;->startActivity(Landroid/content/Intent;)V
 
     invoke-virtual {v1}, Lcom/android/camera/ActivityBase;->L8()V
-- 
