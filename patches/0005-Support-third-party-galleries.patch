From fa769787f7e7bea0a2d8b3cc8dcf093e3317f29c Mon Sep 17 00:00:00 2001
From: Arian <arian.kulmer@web.de>
Date: Fri, 8 Mar 2024 02:11:53 +0100
Subject: [PATCH 5/7] Support third party galleries

---
 smali/com/android/camera/k3.smali       | 4 ----
 smali/com/android/camera/module/j.smali | 4 ++--
 2 files changed, 2 insertions(+), 6 deletions(-)

diff --git a/smali/com/android/camera/k3.smali b/smali/com/android/camera/k3.smali
index bce40bd4f..7749bccbc 100644
--- a/smali/com/android/camera/k3.smali
+++ b/smali/com/android/camera/k3.smali
@@ -143,10 +143,6 @@
     invoke-direct {v1, v5, p2}, Landroid/content/Intent;-><init>(Ljava/lang/String;Landroid/net/Uri;)V
 
     :goto_0
-    const-string p2, "com.miui.gallery"
-
-    invoke-virtual {v1, p2}, Landroid/content/Intent;->setPackage(Ljava/lang/String;)Landroid/content/Intent;
-
     const-string p2, "from_MiuiCamera"
 
     invoke-virtual {v1, p2, v2}, Landroid/content/Intent;->putExtra(Ljava/lang/String;Z)Landroid/content/Intent;
diff --git a/smali/com/android/camera/module/j.smali b/smali/com/android/camera/module/j.smali
index 83ea96407..b081db69c 100644
--- a/smali/com/android/camera/module/j.smali
+++ b/smali/com/android/camera/module/j.smali
@@ -4203,9 +4203,9 @@
 
     invoke-direct {p0, p1}, Landroid/content/Intent;-><init>(Ljava/lang/String;)V
 
-    const-string p1, "com.miui.gallery"
+    const-string p1, "android.intent.category.APP_GALLERY"
 
-    invoke-virtual {p0, p1}, Landroid/content/Intent;->setPackage(Ljava/lang/String;)Landroid/content/Intent;
+    invoke-virtual {p0, p1}, Landroid/content/Intent;->addCategory(Ljava/lang/String;)Landroid/content/Intent;
 
     invoke-virtual {v1, p0}, Landroid/app/Activity;->startActivity(Landroid/content/Intent;)V
 
